{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.js", "test/**/*.js", "scripts/**/*.js"]
}
