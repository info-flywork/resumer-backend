{
  "name": "resumer-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Resumer API — Express + MySQL + Firebase Auth (f2f Studio)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "openapi": "node scripts/openapi.js",
    "register": "node scripts/register.js",
    "check": "tsc -p jsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
